	langid = {american},
	keywords = {Array, Array signal processing, Codes, {CRUD}, Databases, Parallel processing, Relational databases, {SQL}, Structured Query Language, {TDMS}, Time division multiplexing},
	file = {PDF:files/444/Lin和Lin - 2022 - Design of High Speed Relational Database Based on Labview TDMS Format.pdf:application/pdf;Snapshot:files/442/9778835.html:text/html},
