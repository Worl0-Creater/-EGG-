@article{wiley_direct_1977,
	title = {A Direct Time-Domain Measure of Frequency Stability: The Modified Allan Variance},
	volume = {26},
	rights = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/{IEEE}.html},
	issn = {0018-9456},
	url = {http://ieeexplore.ieee.org/document/4314481/},
	doi = {10.1109/TIM.1977.4314481},
	shorttitle = {A Direct Time-Domain Measure of Frequency Stability},
	abstract = {A simple filter is shown to closely approximate the procedure used to compute the "Allan variance," an often used measure of the short term frequency stability of oscillators. This modified Allan variance is obtained by measuring the rms value of the instantaneous frequency waveform after filtering. Some advantages of the modified Allan variance include ease of implementation for short averaging times and better behavior when the instabilities include periodic components. The effect of the bandwidth of the measuring process on the minimum usable averaging time is also discussed.},
	pages = {38--41},
	number = {1},
	journaltitle = {{IEEE} Trans. Instrum. Meas.},
	author = {Wiley, Richard G.},
	urldate = {2025-12-30},
	date = {1977},
	langid = {english},
	note = {{titleTranslation}: 频率稳定度的一种直接时域度量：修正的Allan方差。},
	file = {A Direct Time-Domain Measure of Frequency Stability\: The Modified Allan Variance | IEEE Journals & Magazine | IEEE Xplore:files/482/4314481.html:text/html;PDF:files/308/Wiley - 1977 - A Direct Time-Domain Measure of Frequency Stability The Modified Allan Variance.pdf:application/pdf},
}

